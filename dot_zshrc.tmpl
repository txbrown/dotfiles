# === Homebrew ===
if [ -x /opt/homebrew/bin/brew ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -x /usr/local/bin/brew ]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi
BREW_PREFIX="$(command -v brew >/dev/null 2>&1 && brew --prefix || true)"

# === PATH Setup ===
export PATH="$HOME/bin:$HOME/.local/bin:$HOME/.rbenv/shims:$HOME/.pyenv/shims:$PATH"
if [ -n "$BREW_PREFIX" ]; then
  export PATH="$BREW_PREFIX/bin:$BREW_PREFIX/sbin:$PATH"
  [ -d "$BREW_PREFIX/opt/ruby@3.3/bin" ] && export PATH="$BREW_PREFIX/opt/ruby@3.3/bin:$PATH"
  [ -d "$BREW_PREFIX/opt/dotnet@8/bin" ] && export PATH="$BREW_PREFIX/opt/dotnet@8/bin:$PATH"
  [ -d "$BREW_PREFIX/opt/python@3.13/libexec/bin" ] && export PATH="$BREW_PREFIX/opt/python@3.13/libexec/bin:$PATH"
fi
export PATH="$PATH:$HOME/.maestro/bin"
export PATH="$PATH:/Applications/010 Editor.app/Contents/CmdLine"

# Android
export ANDROID_HOME=$HOME/Library/Android/sdk
export PATH="$PATH:$ANDROID_HOME/emulator:$ANDROID_HOME/platform-tools:$ANDROID_HOME/cmdline-tools/latest/bin:$ANDROID_HOME/tools:$ANDROID_HOME/tools/bin"

# Java
if [ -x /usr/libexec/java_home ]; then
  JAVA_HOME="$(/usr/libexec/java_home -v 17 2>/dev/null || true)"
  [ -n "$JAVA_HOME" ] && export JAVA_HOME
fi

# Go
export GOPATH=$HOME/Go
export PATH="$PATH:$GOPATH/bin"

# === Oh My Zsh ===
export ZSH="$HOME/.oh-my-zsh"
DISABLE_AUTO_UPDATE="true"
DISABLE_MAGIC_FUNCTIONS="true"
DISABLE_COMPFIX="true"
ZSH_THEME="robbyrussell"
plugins=(git vi-mode)

source $ZSH/oh-my-zsh.sh

# === Lazy load NVM ===
export NVM_DIR="$HOME/.nvm"
nvm() {
  unset -f nvm node npm npx
  [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
  [ -n "$BREW_PREFIX" ] && [ -s "$BREW_PREFIX/opt/nvm/nvm.sh" ] && \. "$BREW_PREFIX/opt/nvm/nvm.sh"
  nvm "$@"
}
node() { nvm use default >/dev/null 2>&1; command node "$@"; }
npm() { nvm use default >/dev/null 2>&1; command npm "$@"; }
npx() { nvm use default >/dev/null 2>&1; command npx "$@"; }

# === Lazy load rbenv ===
rbenv() {
  unset -f rbenv
  eval "$(command rbenv init - zsh)"
  rbenv "$@"
}

# === Optional tooling ===
if [ -n "$BREW_PREFIX" ]; then
  [ -f "$BREW_PREFIX/etc/profile.d/autojump.sh" ] && . "$BREW_PREFIX/etc/profile.d/autojump.sh"
  [ -f "$BREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ] && \
    source "$BREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
  [ -f "$BREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ] && \
    source "$BREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
fi
command -v mise >/dev/null 2>&1 && eval "$(mise activate zsh --shims)"

# === Shared environment ===
# Difftastic (`difft`) supports Git's GIT_EXTERNAL_DIFF 7-argument protocol directly.
export GIT_EXTERNAL_DIFF="difft"

# === Functions ===
locatecrash() {
  local line=$1 column=$2 platform=$3
  if [ "$platform" = "ios" ]; then
    filepath="./sourcemaps/sourcemap.ios.js"
  elif [ "$platform" = "android" ]; then
    filepath="./sourcemaps/sourcemap.android.js"
  else
    echo "❌ Unknown platform: $platform (use 'ios' or 'android')"
    return 1
  fi
  npx gulp locate-crash --line=$line --column=$column --filepath="$filepath"
}

# === Aliases ===
alias nart="npm start"
alias myenv='echo "Node: $(node -v), NPM: $(npm -v), Java: $JAVA_HOME, Android: $ANDROID_HOME"'
alias zshconfig="code ~/.zshrc"
alias ohmyzsh="code ~/.oh-my-zsh"

{{- if .is_work }}
# === Work machine ===
alias napp="TOC=EastMidlandsRailway env=et2 ENABLE_NEWRELIC=true npx gulp run-ios --device 'TOCWL - iPhone 16e'"
{{- end }}

