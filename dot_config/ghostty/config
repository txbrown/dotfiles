# Ghostty ergonomics aligned with tmux/neovim directional movement

# Keep native split creation ergonomics
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down

# Split navigation to match vim/tmux mental model
keybind = cmd+alt+h=goto_split:left
keybind = cmd+alt+j=goto_split:down
keybind = cmd+alt+k=goto_split:up
keybind = cmd+alt+l=goto_split:right

# Split resizing
keybind = cmd+alt+shift+h=resize_split:left,5
keybind = cmd+alt+shift+j=resize_split:down,3
keybind = cmd+alt+shift+k=resize_split:up,3
keybind = cmd+alt+shift+l=resize_split:right,5

# Utility actions
keybind = cmd+alt+z=toggle_split_zoom
keybind = cmd+alt+e=equalize_splits
keybind = cmd+alt+w=close_surface
